# Copy this file to env.local, then edit paths for the target machine:
#   cp env.example env.local
#   source env.local

# OpenWAM repository that contains scripts/deploy.py and benchmarks/robotwin/.
export OPENWAM_ROOT="/path/to/OpenWAM"

# Choose one OpenWAM Python bootstrap style.
# Option A: conda
export OPENWAM_CONDA_SH="/path/to/miniconda3/etc/profile.d/conda.sh"
export OPENWAM_CONDA_ENV="openwam"
# Option B: explicit Python. If set, scripts/start_openwam_server.sh uses this
# and ignores OPENWAM_CONDA_SH/OPENWAM_CONDA_ENV.
export OPENWAM_PYTHON=""

# RoboTwin repository or the prepared legacy-compatible copy.
export ROBOTWIN_PATH="/path/to/RoboTwin"
export ROBOTWIN_PYTHON="/path/to/miniconda3/envs/RoboTwin/bin/python"

# Runtime knobs.
export TASK_CONFIG="demo_clean"
export HOST="127.0.0.1"
export RUN_LABEL_PREFIX="eval"
export ROBOTWIN_SKIP_VERSION_CHECK="1"
export ROBOTWIN_ENABLE_PLANNER_FALLBACK="1"
export ROBOTWIN_EXPERT_CHECK="1"

# Optional SAPIEN/EGL overrides. Set these only if your target machine needs
# explicit ICD JSON files.
# export VK_ICD_FILENAMES="/path/to/RoboTwin/env/lib/python3.10/site-packages/sapien/vulkan_library/nvidia_icd.json"
# export __EGL_VENDOR_LIBRARY_FILENAMES="/path/to/RoboTwin/env/lib/python3.10/site-packages/sapien/vulkan_library/10_nvidia.json"
